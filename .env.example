# --- Core ---
NODE_ENV=development
# Public base domain for deployed apps. Apps get <app-name>.<BASE_DOMAIN>.
# Use "localhost" for local dev (Traefik serves *.localhost over plain HTTP).
BASE_DOMAIN=localhost
# URL the dashboard is served at (used for OAuth redirects and CORS)
WEB_URL=http://localhost:5173
# URL the API is reachable at from the browser
API_URL=http://localhost:3000
API_PORT=3000

# --- Database ---
POSTGRES_USER=springlane
POSTGRES_PASSWORD=springlane
POSTGRES_DB=springlane
POSTGRES_PORT=5433
DATABASE_URL=postgresql://springlane:springlane@localhost:5433/springlane

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Max simultaneous builds on this host
BUILD_CONCURRENCY=2

# --- GitHub OAuth App ---
# Any GitHub account can log in; repo access is scoped to what the user authorizes.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Security ---
# 32-byte hex key for AES-256-GCM encryption of tokens/env vars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Secret for Better Auth (sessions, cookies). Min 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public URL for OAuth (dev: dashboard + Vite proxy; prod: your deploy URL)
BETTER_AUTH_URL=http://localhost:5173

# --- Build & runtime ---
# Where build logs are written (LogStorage local-disk backend)
LOG_DIR=./data/logs
# Ephemeral clone/build workspace (removed after each job)
BUILD_WORKSPACE=./data/builds
# Docker socket for ContainerRuntime lifecycle operations (optional override)
# DOCKER_SOCKET=/var/run/docker.sock
# Docker network shared with Traefik; deployed app containers are attached to it
TRAEFIK_NETWORK=spring-lane
# Default resource limits for deployed apps
DEFAULT_APP_MEMORY_MB=512
DEFAULT_APP_CPUS=1
# Email for Let's Encrypt (production only)
ACME_EMAIL=
